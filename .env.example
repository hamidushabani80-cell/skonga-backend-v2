# ══════════════════════════════════════
# SKONGA AI BACKEND — Environment Variables
# Copy this file as .env then fill in your keys
# ══════════════════════════════════════

PORT=3000
NODE_ENV=development

# ── AI Provider Keys ──
GROQ_API_KEY=
# Groq model overrides (optional). Defaults after Aug 16 2026 deprecation:
#   chat/reasoning → openai/gpt-oss-120b
#   fast           → openai/gpt-oss-20b
# Official note: https://console.groq.com/docs/deprecations
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# Alternative chat model (also recommended by Groq): qwen/qwen3.6-27b
OPENROUTER_API_KEY=
AIMLAPI_KEY=
BAZAARLINK_API_KEY=
TAVILY_API_KEY=
# Gemini (Google AI Studio) — FREE, no payment card needed.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

AIMLAPI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=

POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=

PROVIDER_FALLBACK_ORDER=groq,openrouter,aimlapi,pollinations,bazaarlink,gemini

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

PROVIDER_MAX_RETRIES=1
PROVIDER_TIMEOUT_MS=25000

OPENROUTER_SITE_URL=https://skonga.ai
OPENROUTER_SITE_NAME=SKONGA AI

# SKONGA Library API (curriculum RAG — internal only)
LIBRARY_ENABLED=false
LIBRARY_API_URL=https://skonga-library-api.onrender.com
LIBRARY_SERVICE_TOKEN=
LIBRARY_TIMEOUT_MS=5000
